WORLDBUILDER_DATABASE_URL=sqlite:///./worldbuilder.sqlite3
WORLDBUILDER_API_PREFIX=/api
WORLDBUILDER_LLM_BASE_URL=http://127.0.0.1:1234/v1
WORLDBUILDER_LLM_API_KEY=
WORLDBUILDER_LLM_MODEL=
WORLDBUILDER_LLM_TIMEOUT_SECONDS=120
WORLDBUILDER_MAX_ENTITIES_PER_EXTRACT=12
POSTGRES_PASSWORD=
WORLDBUILDER_TRUST_LOCAL_MASTER=true
WORLDBUILDER_ALLOWED_HOSTS=localhost,testserver
WORLDBUILDER_MAX_REQUEST_BYTES=10485760
WORLDBUILDER_EMBEDDING_DIMENSIONS=1024
WORLDBUILDER_LOCAL_WORKER_ENABLED=true
# Docker/LAN: replace this value before exposing the API.
WORLDBUILDER_MASTER_TOKEN=
